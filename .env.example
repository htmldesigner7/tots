# ---------------------------------------------------------------------------
# Ananya Tots – environment configuration
# Copy to .env, fill in real values on the server, then run `php artisan key:generate`.
# NEVER commit .env or put real passwords in this file.
# ---------------------------------------------------------------------------
APP_NAME="Ananya Tots"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public address of the site (used for canonical URLs, sitemap, e-mails)
APP_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8.0+ / MariaDB 10.6+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ananya_tots
DB_USERNAME=ananya_tots
DB_PASSWORD=

# Sessions: secure, HTTP-only cookies (HTTPS required in production)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Image processing runs during the upload request; no queue worker is required.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_STORE=redis  (recommended when available)

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail (enquiry notifications, password resets)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CMS -------------------------------------------------------------------
# URL prefix of the admin panel, e.g. "school-admin" → https://site/school-admin
CMS_ADMIN_PATH=admin
# Maximum media upload size in KB (also check upload_max_filesize / post_max_size in php.ini)
CMS_MAX_UPLOAD_KB=10240
# Content-Security-Policy header (leave on)
CMS_CSP=true
# Comma separated proxy IPs when running behind a load balancer / Cloudflare, or * to trust all
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
